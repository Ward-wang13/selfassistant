# Optional: enables Brave Search-backed feed expansion.
# Copy this file to `.env.local`, then fill in your real key.
BRAVE_SEARCH_API_KEY=

# Optional development-only agent prompt/response logs.
# Leave disabled for normal use because logs may contain source text.
SELFASSISTANT_AGENT_DEBUG_LOGS=

# Optional DeepSeek API provider. Keep this server-side; never expose it to the browser.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
